{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "composite": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "deepfilter-wasm-bindgen": ["./node_modules/deepfilter-standalone/dist/df3/df.d.ts"],
      "rnnoise-wasm-polyfills": ["./node_modules/@timephy/rnnoise-wasm/dist/polyfills.d.ts"],
      "rnnoise-wasm-processor": ["./node_modules/@timephy/rnnoise-wasm/dist/RnnoiseProcessor.d.ts"],
      "rnnoise-wasm-sync": ["./node_modules/@timephy/rnnoise-wasm/dist/generated/rnnoise-sync.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/renderer/src/**/*"]
}